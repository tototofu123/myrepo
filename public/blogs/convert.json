{
  "_comment": "Conversion spec for generate-blog.js. Human-readable reference for how Markdown is converted to HTML and where files land.",
  "version": "2.0",
  "updated": "2026-05-23",

  "fileStructure": {
    "description": "Every blog post lives in its own subfolder under /blogs/",
    "pattern": "/blogs/<slug>/<slug>.html",
    "examples": [
      "/blogs/how-myrepo-blog-pipeline-works/how-myrepo-blog-pipeline-works.html",
      "/blogs/my-stm32-uart-journey/my-stm32-uart-journey.html"
    ],
    "assets": [
      { "file": "public/blogs/blog-styles.css",  "role": "Canonical stylesheet, linked by every post as ../blog-styles.css" },
      { "file": "public/blogs/convert.json",     "role": "This file — human-readable conversion spec" },
      { "file": "public/blogs/index.html",       "role": "Auto-generated listing of all posts" }
    ]
  },

  "frontmatter": {
    "description": "YAML block between --- delimiters at the top of the GitHub issue body",
    "fields": {
      "title":   { "type": "string",   "required": true,  "usage": "<title>, <h1 class=post-title>, og:title" },
      "slug":    { "type": "string",   "required": true,  "usage": "folder name and HTML filename" },
      "date":    { "type": "YYYY-MM-DD","required": true,  "usage": "<time datetime=> and card date" },
      "summary": { "type": "string",   "required": false, "usage": "<p class=post-summary>, meta description, card summary" },
      "tags":    { "type": "string[]|string", "required": false, "usage": "<span class=tag> badges in post header" }
    },
    "example": "---\ntitle: \"My Post\"\nslug: my-post\ndate: \"2026-05-23\"\nsummary: \"One-liner about the post.\"\ntags: [embedded, stm32]\n---"
  },

  "markdownToHtml": {
    "description": "Mapping of every Markdown construct to its output HTML element and CSS class",
    "conversions": [
      {
        "markdown": "# Heading",
        "html": "<h1>",
        "note": "Inside .post-body only — not the post title (which comes from frontmatter)",
        "css": ".post-body h1 — Instrument Serif, --text-xl, dark top margin"
      },
      {
        "markdown": "## Heading",
        "html": "<h2>",
        "css": ".post-body h2 — Instrument Serif, --text-lg"
      },
      {
        "markdown": "### Heading",
        "html": "<h3>",
        "css": ".post-body h3 — Work Sans semibold, --text-base"
      },
      {
        "markdown": "#### / ##### / ######",
        "html": "<h4> / <h5> / <h6>",
        "css": ".post-body h4/h5/h6 — Work Sans, --text-sm, uppercase, tracked, muted color"
      },
      {
        "markdown": "paragraph text",
        "html": "<p>",
        "css": ".post-body p — max-width 72ch, line-height 1.75, margin-bottom --space-6"
      },
      {
        "markdown": "**bold**",
        "html": "<strong>",
        "css": ".post-body strong — font-weight 600"
      },
      {
        "markdown": "*italic* or _italic_",
        "html": "<em>",
        "css": ".post-body em — font-style italic"
      },
      {
        "markdown": "`inline code`",
        "html": "<code>",
        "css": ".post-body code — font-mono, 0.88em, surface-2 bg, border, radius-sm"
      },
      {
        "markdown": "```lang\ncode block\n```",
        "html": "<pre><code class=\"language-{lang}\">",
        "css": ".post-body pre — dark bg #1c1b19, radius-lg, overflow-x auto, shadow-md"
      },
      {
        "markdown": "> blockquote",
        "html": "<blockquote>",
        "css": ".post-body blockquote — teal left-border 3px, surface bg, italic, muted text"
      },
      {
        "markdown": "- item or * item",
        "html": "<ul><li>",
        "css": ".post-body ul — list-style disc, left margin --space-6"
      },
      {
        "markdown": "1. item",
        "html": "<ol><li>",
        "css": ".post-body ol — list-style decimal, left margin --space-6"
      },
      {
        "markdown": "---",
        "html": "<hr>",
        "css": ".post-body hr — 1px divider color, no border"
      },
      {
        "markdown": "| col | col |\n|---|---|\n| val | val |",
        "html": "<table><thead><tr><th>...</th></tr></thead><tbody><tr><td>...</td></tr></tbody></table>",
        "css": ".post-body table — tabular-nums, th uppercase tracked, tr hover surface"
      },
      {
        "markdown": "![alt](url)\n*caption*",
        "html": "<figure><img loading=lazy><figcaption>",
        "css": ".post-body figure — center aligned; img radius-lg shadow-md; figcaption --text-xs faint"
      },
      {
        "markdown": "![alt](url)",
        "html": "<img loading=\"lazy\">",
        "note": "Plain image without caption — no figure wrapper"
      },
      {
        "markdown": "[text](url)",
        "html": "<a target=_blank rel=noopener>",
        "css": ".post-body a — primary color, underline, underline-offset 3px"
      }
    ]
  },

  "specialElements": {
    "aiImageCredit": {
      "html": "<p class=\"img-credit\">",
      "description": "Added manually by generate-blog.js when image URL contains AI-generated metadata",
      "css": ".img-credit — font-size 0.6rem, color-text-faint, text-align center",
      "format": "AI-generated · Prompt: \"<prompt text>\""
    },
    "tag": {
      "html": "<span class=\"tag\">",
      "description": "Rendered from frontmatter tags[] in the post header",
      "css": ".tag — primary-highlight bg, primary color, uppercase, --text-xs, radius-full"
    },
    "revealAnimation": {
      "description": "Classes applied to .post-header and .post-body for IntersectionObserver scroll reveal",
      "classes": [".reveal", ".reveal.visible"],
      "css": ".reveal — opacity 0, translateY 16px; .reveal.visible — opacity 1, translateY 0"
    }
  },

  "stylesheet": {
    "file": "public/blogs/blog-styles.css",
    "linkedAs": "../blog-styles.css",
    "description": "Single external CSS file shared by all blog posts and the /blogs/ index. Contains all tokens, reset, layout, and element styles listed in markdownToHtml above.",
    "fonts": [
      { "name": "Instrument Serif", "role": "display (--font-display)", "source": "Google Fonts" },
      { "name": "Work Sans",        "role": "body (--font-body)",    "source": "Google Fonts" },
      { "name": "Fira Code",        "role": "mono (--font-mono) — fallback only, not preloaded", "source": "system fallback" }
    ],
    "colorScheme": "Nexus design system — warm beige light / dark charcoal dark, teal primary accent",
    "darkMode": "[data-theme=dark] override + @media prefers-color-scheme fallback"
  },

  "workflow": {
    "triggerFile": ".github/workflows/create-blog-post.yml",
    "scriptFile":  ".github/scripts/generate-blog.js",
    "trigger": "on: issues: [opened, labeled] where label == 'blog'",
    "steps": [
      "1. Checkout repo",
      "2. Setup Node 20",
      "3. npm ci",
      "4. node .github/scripts/generate-blog.js (env: ISSUE_BODY, ISSUE_TITLE, ISSUE_NUMBER)",
      "5. Commit public/blogs/<slug>/<slug>.html + updated public/blogs/index.html",
      "6. peaceiris/actions-gh-pages → deploy public/ to gh-pages branch",
      "7. github-script → post live URL comment on issue, close issue"
    ],
    "outputPath": "public/blogs/<slug>/<slug>.html"
  }
}
